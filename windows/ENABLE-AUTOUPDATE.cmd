@echo off
setlocal
set "KITAI_AUTOUPDATE_SELF=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $dir=Join-Path ([IO.Path]::GetTempPath()) ('kitai-autoupdate-'+[guid]::NewGuid().ToString('N')); try { $raw=[IO.File]::ReadAllText($env:KITAI_AUTOUPDATE_SELF); $data=($raw -split ':KITAI_PAYLOAD\r?\n',2)[1].Trim(); [IO.Directory]::CreateDirectory($dir) | Out-Null; $zip=Join-Path $dir 'payload.zip'; [IO.File]::WriteAllBytes($zip,[Convert]::FromBase64String($data)); Expand-Archive -LiteralPath $zip -DestinationPath $dir -Force; & powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $dir 'Setup.ps1'); $rc=$LASTEXITCODE } catch { Write-Host $_.Exception.Message -ForegroundColor Red; $rc=1 } finally { if(Test-Path -LiteralPath $dir){Remove-Item -LiteralPath $dir -Recurse -Force} }; exit $rc"
set "KITAI_AUTOUPDATE_RESULT=%ERRORLEVEL%"
echo.
if not "%KITAI_AUTOUPDATE_RESULT%"=="0" echo SETUP OR INITIAL CHECK FAILED. Read the error above.
pause
exit /b %KITAI_AUTOUPDATE_RESULT%
:KITAI_PAYLOAD

